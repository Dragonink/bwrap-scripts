#!/usr/bin/env python3

import sys

from common import *

dbus_proxy = DbusProxy()
bwrap = Bwrap(dbus_proxy)
# Runtimes
bwrap.ro(XDG_DATA_HOME / "faugus-launcher" / "umu-run")
bwrap.ro("/etc/ld.so.cache")
bwrap.ro("/var/cache/ldconfig")
bwrap.dev("/sys")
# UMU
bwrap.rw(XDG_CACHE_HOME / "umu", create_dir=True)
bwrap.rw(XDG_DATA_HOME / "umu", create_dir=True)
bwrap.ro("/etc/ssl")
bwrap.ro("/etc/pki/tls")
bwrap.ro("/etc/passwd")
bwrap.ro("/etc/group")
PROTONPATH = "PROTONPATH"
bwrap.ro(os.getenv(PROTONPATH))
bwrap.env(PROTONPATH)
bwrap.env("STORE")
bwrap.env("GAMEID")
bwrap.env("UMU_RUNTIME_UPDATE")
bwrap.env("UMU_HTTP_TIMEOUT")
bwrap.env("UMU_HTTP_RETRIES")
bwrap.env("UMU_LOG")
# Proton / Wine
WINEPREFIX = "WINEPREFIX"
bwrap.rw(os.getenv(WINEPREFIX))
bwrap.env(WINEPREFIX)
bwrap.ro("/etc/machine-id")
bwrap.rw(XDG_CACHE_HOME / "protonfixes", create_dir=True)
bwrap.rw(XDG_CACHE_HOME / "winetricks", create_dir=True)

bwrap.network()
bwrap.display()
bwrap.gpus()
bwrap.audio()
bwrap.input()
# Performance
bwrap.dev("/dev/hugepages")
bwrap.dev("/dev/ntsync")
# Game
bwrap.rw(os.getenv("STEAM_COMPAT_INSTALL_PATH"))

if __name__ == "__main__":
    main(bwrap, sys.argv[1:])
